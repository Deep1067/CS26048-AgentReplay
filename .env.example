LIVE_RUN_AUTH_TOKEN=
CONFIG_MUTATIONS_ENABLED=false
# Required for remote pricing/detector changes if CONFIG_MUTATIONS_ENABLED is enabled.
CONFIG_MUTATIONS_AUTH_TOKEN=
