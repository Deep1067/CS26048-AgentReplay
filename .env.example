GEMINI_API_KEY=
DEFAULT_MODEL=gemini-flash-lite-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
USD_TO_INR=83
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required on Vercel; protects the UI and all APIs with HTTP Basic authentication.
# Use a long random password (at least 24 characters) and HTTPS.
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
# Only set true for standalone loopback development; never behind a reverse proxy.
ALLOW_LOOPBACK_PRIVILEGED_ACTIONS=false
# Live model and fixed-scenario runs are disabled unless explicitly enabled.
LIVE_RUN_ENABLED=false
# Set a separate high-entropy token before enabling provider execution.
# The UI sends it transiently in X-Live-Run-Token.
LIVE_RUN_AUTH_TOKEN=
CONFIG_MUTATIONS_ENABLED=false
# Required for pricing/detector changes if CONFIG_MUTATIONS_ENABLED is enabled.
# The UI sends it transiently in X-Config-Mutations-Token.
CONFIG_MUTATIONS_AUTH_TOKEN=
